# ─── Groq API (free tier, no credit card required) ───
# Get your key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ─── Whisper Model ───
# Options: tiny, base, small, medium, large-v3, large-v3-turbo
# "base" is the default (fast, ~140MB). Use "small" for better multilingual accuracy (~460MB).
WHISPER_MODEL_SIZE=base

# ─── PostgreSQL ───
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sales_analytics
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sales_analytics

# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── ChromaDB ───
CHROMA_PERSIST_DIR=/app/data/chroma
